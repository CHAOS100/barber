rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPhoneCustomer() {
      return signedIn()
        && (
          request.auth.token.firebase.sign_in_provider == 'phone'
          || request.auth.token.native_phone_auth == true
        );
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Root user roles are descriptive only. Tenant access always requires an
    // active membership document scoped to the requested businessId.
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == 'platform_admin'
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.active == true;
    }

    function hasActiveBusinessMembership(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.active == true;
    }

    function hasBusinessRole(businessId, role) {
      return hasActiveBusinessMembership(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role == role;
    }

    function isBusinessOwner(businessId) {
      return hasBusinessRole(businessId, 'business_owner');
    }

    function isBusinessStaff(businessId) {
      return hasBusinessRole(businessId, 'staff');
    }

    function canAccessBusiness(businessId) {
      return isPlatformAdmin() || isBusinessOwner(businessId) || isBusinessStaff(businessId);
    }

    function canManageBusiness(businessId) {
      return isPlatformAdmin() || isBusinessOwner(businessId);
    }

    function isActiveBusiness(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'active';
    }

    function ownsAppointment() {
      return isPhoneCustomer()
        && (
          resource.data.customerId == request.auth.uid
          || (
            resource.data.customerPhone is string
            && (
              (
                request.auth.token.firebase.sign_in_provider == 'phone'
                && resource.data.customerPhone == request.auth.token.phone_number
              )
              || (
                request.auth.token.native_phone_auth == true
                && resource.data.customerPhone == request.auth.token.native_phone_number
              )
            )
          )
        );
    }

    function ownsUserDocument(userId) {
      return isPhoneCustomer() && request.auth.uid == userId;
    }

    function ownsWaitingListEntry() {
      return isPhoneCustomer() && resource.data.customerId == request.auth.uid;
    }

    function ownsCustomerNotification(customerId) {
      return isPhoneCustomer() && request.auth.uid == customerId;
    }

    function isCriticalNotificationData(data) {
      return data.type in ['warning', 'block', 'payment_request', 'no_show_payment_required']
        || (
          data.type == 'warning'
          && data.keys().hasAny(['requiresAction'])
          && data.requiresAction == true
        );
    }

    function hasValidCustomerNames(data) {
      return data.firstName is string
        && data.firstName.size() > 0
        && data.lastName is string
        && data.lastName.size() > 0;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || ownsAppointment();
      allow create, update, delete: if false;
    }

    match /appointmentBlocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /barbers/{barberId} {
      // Public business profile data — anyone can list/read barbers.
      // Client-side isBarberBookable() handles active/archived filtering so
      // legacy docs (missing 'active' field) are treated as active correctly.
      // A restrictive rule here caused Firestore to reject the broad collection
      // query (no where clauses) for non-admin users, returning empty results.
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/booking {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/business {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /platformAdmins/{platformAdminId} {
      allow read: if signedIn()
        && (request.auth.uid == platformAdminId || isPlatformAdmin());
      allow write: if false;
    }

    match /businesses/{businessId} {
      allow read: if resource.data.status == 'active' || canAccessBusiness(businessId);
      // Provisioning/status/subscription changes must create related membership
      // state atomically in trusted backend code.
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if isPlatformAdmin()
          || isBusinessOwner(businessId)
          || (signedIn() && request.auth.uid == memberId);
        allow create, update, delete: if false;
      }

      match /services/{serviceId} {
        allow read: if canAccessBusiness(businessId)
          || (isActiveBusiness(businessId) && resource.data.active == true);
        allow create, update, delete: if canManageBusiness(businessId);
      }

      match /staff/{staffId} {
        allow read: if canAccessBusiness(businessId)
          || (isActiveBusiness(businessId)
            && resource.data.active == true
            && (
              !resource.data.keys().hasAny(['archived'])
              || resource.data.archived != true
            ));
        allow create, update: if canManageBusiness(businessId);
        allow delete: if false;
      }

      match /appointments/{appointmentId} {
        allow read: if canAccessBusiness(businessId)
          || (isPhoneCustomer() && resource.data.customerId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /customers/{customerId} {
        allow read: if canAccessBusiness(businessId)
          || (signedIn() && request.auth.uid == customerId);
        allow create, update, delete: if false;

        match /notifications/{notificationId} {
          allow read: if canAccessBusiness(businessId)
            || (signedIn() && request.auth.uid == customerId);
          allow create, update, delete: if false;
        }
      }

      match /reviews/{reviewId} {
        allow read: if canAccessBusiness(businessId)
          || (isActiveBusiness(businessId) && resource.data.status == 'published')
          || (isPhoneCustomer() && resource.data.customerId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /gallery/{itemId} {
        allow read: if canAccessBusiness(businessId)
          || (isActiveBusiness(businessId) && resource.data.active == true);
        allow create, update, delete: if canManageBusiness(businessId);
      }

      match /notificationJobs/{jobId} {
        allow read: if canAccessBusiness(businessId);
        allow write: if false;
      }

      match /waitingList/{entryId} {
        allow read: if canAccessBusiness(businessId)
          || (isPhoneCustomer() && resource.data.customerId == request.auth.uid);
        allow create: if false;
        allow update: if canAccessBusiness(businessId)
          || (
            isPhoneCustomer()
            && resource.data.customerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
          );
        allow delete: if canManageBusiness(businessId);
      }

      match /settings/{settingId} {
        allow read: if settingId in ['business', 'booking']
          && (canAccessBusiness(businessId) || isActiveBusiness(businessId));
        allow create, update: if canManageBusiness(businessId)
          && settingId in ['business', 'booking'];
        allow delete: if false;
      }

      match /appointmentBlocks/{blockId} {
        allow read: if canAccessBusiness(businessId) || isActiveBusiness(businessId);
        allow write: if false;
      }

      match /bookingSlotReleases/{releaseId} {
        allow read: if canAccessBusiness(businessId) || isActiveBusiness(businessId);
        allow create, update: if canManageBusiness(businessId);
        allow delete: if false;
      }

      match /appointmentScheduleLocks/{lockId} {
        allow read, write: if false;
      }

      match /customerBookingLocks/{customerId} {
        allow read, write: if false;
      }

      match /waitingListCustomerLocks/{customerId} {
        allow read, write: if false;
      }

      match /{tenantDocument=**} {
        allow read, write: if false;
      }
    }

    // Push notification device tokens — customers write their own, admin can read
    match /users/{userId}/pushTokens/{tokenId} {
      allow read: if isAdmin() || ownsUserDocument(userId);
      allow create, update: if ownsUserDocument(userId)
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.enabled is bool;
      allow delete: if ownsUserDocument(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsUserDocument(userId);

      allow create: if ownsUserDocument(userId)
        && request.resource.data.uid == request.auth.uid
        && (
          (
            request.auth.token.firebase.sign_in_provider == 'phone'
            && request.resource.data.phoneNumber == request.auth.token.phone_number
          )
          || (
            request.auth.token.native_phone_auth == true
            && request.resource.data.phoneNumber == request.auth.token.native_phone_number
          )
        )
        && request.resource.data.role == 'customer'
        && request.resource.data.visitsCount == 0
        && request.resource.data.completedAppointments == 0
        && request.resource.data.cancelledAppointments == 0
        && request.resource.data.noShowCount == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.reviewsCount == 0
        && request.resource.data.blocked == false
        && request.resource.data.blockedReason == ''
        && request.resource.data.blockedAt == null
        && request.resource.data.blockedBy == null
        && hasValidCustomerNames(request.resource.data)
        && request.resource.data.keys().hasAll([
          'uid',
          'phoneNumber',
          'firstName',
          'lastName',
          'role',
          'visitsCount',
          'completedAppointments',
          'cancelledAppointments',
          'noShowCount',
          'totalSpent',
          'reviewsCount',
          'blocked',
          'blockedReason',
          'blockedAt',
          'blockedBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'firstName',
          'lastName',
          'role',
          'visitsCount',
          'completedAppointments',
          'cancelledAppointments',
          'noShowCount',
          'totalSpent',
          'reviewsCount',
          'blocked',
          'blockedReason',
          'blockedAt',
          'blockedBy',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ]);

      allow update: if (
          ownsUserDocument(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'notificationPreferences',
            'language',
            'updatedAt'
          ])
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'blocked',
            'blockedReason',
            'blockedAt',
            'blockedBy',
            'isBlocked',
            'warningCount',
            'warning',
            'warnings',
            'lastWarningReason',
            'warningClearedAt',
            'warningClearedBy',
            'warningClearedReason',
            'requiresNoShowPayment',
            'noShowPaymentAmount',
            'noShowPaymentReason',
            'relatedAppointmentId',
            'paymentClearedAt',
            'paymentClearedBy',
            'paymentClearedReason',
            'blockClearedAt',
            'blockClearedBy',
            'blockClearedReason',
            'updatedAt'
          ])
          && hasValidCustomerNames(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'blocked',
              'blockedReason',
              'blockedAt',
              'blockedBy'
            ])
            || (
              request.resource.data.blocked == true
              && request.resource.data.blockedReason is string
              && request.resource.data.blockedReason.size() > 0
              && request.resource.data.blockedBy == request.auth.uid
            )
            || (
              request.resource.data.blocked == false
              && request.resource.data.blockedReason == ''
              && request.resource.data.blockedAt == null
              && request.resource.data.blockedBy == null
            )
          )
        );

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || resource.data.status == 'published'
        || (isPhoneCustomer() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /customerNotifications/{customerId} {
      allow read: if isAdmin() || ownsCustomerNotification(customerId);
      allow create, update, delete: if false;

      match /notifications/{notificationId} {
        allow read: if isAdmin() || ownsCustomerNotification(customerId);
        allow create, update, delete: if isAdmin();

        allow update: if ownsCustomerNotification(customerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'readAt',
            'readBy',
            'readByName',
            'readByPhone',
            'hiddenAt',
            'hiddenBy',
            'updatedAt'
          ])
          && request.resource.data.status in ['unread', 'read', 'hidden']
          && (
            (
              request.resource.data.status == 'read'
              && request.resource.data.readBy == request.auth.uid
            )
            || (
              request.resource.data.status == 'hidden'
              && !isCriticalNotificationData(resource.data)
              && request.resource.data.hiddenBy == request.auth.uid
            )
            || request.resource.data.status == 'unread'
          );
      }
    }

    match /gallery/{photoId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /waitingList/{waitlistId} {
      allow read: if isAdmin() || ownsWaitingListEntry();

      allow create: if false;

      allow update: if isAdmin()
        || (
          ownsWaitingListEntry()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && request.resource.data.status == 'cancelled'
        );

      allow delete: if isAdmin();
    }

    match /customerBookingLocks/{customerId} {
      allow read, write: if false;
    }

    match /appointmentScheduleLocks/{scheduleId} {
      allow read, write: if false;
    }

    match /waitingListCustomerLocks/{customerId} {
      allow read, write: if false;
    }

    match /bookingSlotReleases/{releaseId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /notificationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
