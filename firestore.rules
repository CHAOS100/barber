rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPhoneCustomer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function ownsAppointment() {
      return isPhoneCustomer() && resource.data.customerId == request.auth.uid;
    }

    function ownsUserDocument(userId) {
      return isPhoneCustomer() && request.auth.uid == userId;
    }

    function hasValidCustomerNames(data) {
      return data.firstName is string
        && data.firstName.size() > 0
        && data.lastName is string
        && data.lastName.size() > 0;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || ownsAppointment();
      allow create, update, delete: if false;
    }

    match /appointmentBlocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if isAdmin()
        || (resource.data.active == true && resource.data.archived == false);
      allow create, update, delete: if isAdmin();
    }

    match /settings/booking {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/business {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsUserDocument(userId);

      allow create: if ownsUserDocument(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.role == 'customer'
        && hasValidCustomerNames(request.resource.data)
        && request.resource.data.keys().hasAll([
          'uid',
          'phoneNumber',
          'firstName',
          'lastName',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'firstName',
          'lastName',
          'role',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ]);

      allow update: if (
          ownsUserDocument(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'notificationPreferences',
            'language',
            'updatedAt'
          ])
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'isBlocked',
            'warningCount',
            'updatedAt'
          ])
          && hasValidCustomerNames(request.resource.data)
        );

      allow delete: if false;
    }

    match /notificationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
