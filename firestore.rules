rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPhoneCustomer() {
      return signedIn()
        && (
          request.auth.token.firebase.sign_in_provider == 'phone'
          || request.auth.token.native_phone_auth == true
        );
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function ownsAppointment() {
      return isPhoneCustomer() && resource.data.customerId == request.auth.uid;
    }

    function ownsUserDocument(userId) {
      return isPhoneCustomer() && request.auth.uid == userId;
    }

    function ownsWaitingListEntry() {
      return isPhoneCustomer() && resource.data.customerId == request.auth.uid;
    }

    function ownsCustomerNotification(customerId) {
      return isPhoneCustomer() && request.auth.uid == customerId;
    }

    function hasValidCustomerNames(data) {
      return data.firstName is string
        && data.firstName.size() > 0
        && data.lastName is string
        && data.lastName.size() > 0;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || ownsAppointment();
      allow create, update, delete: if false;
    }

    match /appointmentBlocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if isAdmin()
        || (resource.data.active == true && resource.data.archived == false);
      allow create, update, delete: if isAdmin();
    }

    match /settings/booking {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/business {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsUserDocument(userId);

      allow create: if ownsUserDocument(userId)
        && request.resource.data.uid == request.auth.uid
        && (
          (
            request.auth.token.firebase.sign_in_provider == 'phone'
            && request.resource.data.phoneNumber == request.auth.token.phone_number
          )
          || (
            request.auth.token.native_phone_auth == true
            && request.resource.data.phoneNumber == request.auth.token.native_phone_number
          )
        )
        && request.resource.data.role == 'customer'
        && request.resource.data.visitsCount == 0
        && request.resource.data.completedAppointments == 0
        && request.resource.data.cancelledAppointments == 0
        && request.resource.data.noShowCount == 0
        && request.resource.data.totalSpent == 0
        && request.resource.data.reviewsCount == 0
        && request.resource.data.blocked == false
        && request.resource.data.blockedReason == ''
        && request.resource.data.blockedAt == null
        && request.resource.data.blockedBy == null
        && hasValidCustomerNames(request.resource.data)
        && request.resource.data.keys().hasAll([
          'uid',
          'phoneNumber',
          'firstName',
          'lastName',
          'role',
          'visitsCount',
          'completedAppointments',
          'cancelledAppointments',
          'noShowCount',
          'totalSpent',
          'reviewsCount',
          'blocked',
          'blockedReason',
          'blockedAt',
          'blockedBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'phoneNumber',
          'firstName',
          'lastName',
          'role',
          'visitsCount',
          'completedAppointments',
          'cancelledAppointments',
          'noShowCount',
          'totalSpent',
          'reviewsCount',
          'blocked',
          'blockedReason',
          'blockedAt',
          'blockedBy',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ]);

      allow update: if (
          ownsUserDocument(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'notificationPreferences',
            'language',
            'updatedAt'
          ])
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'blocked',
            'blockedReason',
            'blockedAt',
            'blockedBy',
            'isBlocked',
            'warningCount',
            'updatedAt'
          ])
          && hasValidCustomerNames(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'blocked',
              'blockedReason',
              'blockedAt',
              'blockedBy'
            ])
            || (
              request.resource.data.blocked == true
              && request.resource.data.blockedReason is string
              && request.resource.data.blockedReason.size() > 0
              && request.resource.data.blockedBy == request.auth.uid
            )
            || (
              request.resource.data.blocked == false
              && request.resource.data.blockedReason == ''
              && request.resource.data.blockedAt == null
              && request.resource.data.blockedBy == null
            )
          )
        );

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || resource.data.status == 'published'
        || (isPhoneCustomer() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /customerNotifications/{customerId} {
      allow read: if isAdmin() || ownsCustomerNotification(customerId);
      allow create, update, delete: if false;

      match /notifications/{notificationId} {
        allow read: if isAdmin() || ownsCustomerNotification(customerId);
        allow create, update, delete: if isAdmin();

        allow update: if ownsCustomerNotification(customerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'readAt',
            'hiddenAt',
            'updatedAt'
          ])
          && request.resource.data.status in ['unread', 'read', 'hidden'];
      }
    }

    match /gallery/{photoId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /waitingList/{waitlistId} {
      allow read: if isAdmin() || ownsWaitingListEntry();

      allow create: if isPhoneCustomer()
        && request.resource.data.customerId == request.auth.uid
        && (
          (
            request.auth.token.firebase.sign_in_provider == 'phone'
            && request.resource.data.phoneNumber == request.auth.token.phone_number
          )
          || (
            request.auth.token.native_phone_auth == true
            && request.resource.data.phoneNumber == request.auth.token.native_phone_number
          )
        )
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.date is string
        && request.resource.data.status == 'active'
        && request.resource.data.preferenceType in [
          'exact_time',
          'time_range',
          'day_part',
          'whole_day'
        ]
        && (
          (
            request.resource.data.preferenceType == 'exact_time'
            && request.resource.data.exactTime is string
            && request.resource.data.exactTime.size() == 5
          )
          || (
            request.resource.data.preferenceType == 'time_range'
            && request.resource.data.startTime is string
            && request.resource.data.startTime.size() == 5
            && request.resource.data.endTime is string
            && request.resource.data.endTime.size() == 5
          )
          || (
            request.resource.data.preferenceType == 'day_part'
            && request.resource.data.dayPart in ['morning', 'noon', 'evening']
          )
          || request.resource.data.preferenceType == 'whole_day'
        )
        && request.resource.data.keys().hasAll([
          'customerId',
          'customerName',
          'phoneNumber',
          'date',
          'preferenceType',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerId',
          'customerName',
          'phoneNumber',
          'date',
          'preferenceType',
          'exactTime',
          'startTime',
          'endTime',
          'dayPart',
          'serviceId',
          'serviceName',
          'status',
          'createdAt',
          'updatedAt',
          'notifiedAt',
          'expiresAt'
        ]);

      allow update: if isAdmin()
        || (
          ownsWaitingListEntry()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && request.resource.data.status == 'cancelled'
        );

      allow delete: if isAdmin();
    }

    match /customerBookingLocks/{customerId} {
      allow read, write: if false;
    }

    match /notificationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
