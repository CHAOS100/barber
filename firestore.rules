rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPhoneCustomer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function ownsAppointment() {
      return isPhoneCustomer() && resource.data.customerId == request.auth.uid;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || ownsAppointment();
      allow create, update, delete: if false;
    }

    match /appointmentBlocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /barbers/{barberId} {
      allow read: if isAdmin()
        || (resource.data.active == true && resource.data.archived == false);
      allow create, update, delete: if isAdmin();
    }

    match /settings/booking {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /notificationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
