{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "customer_name": { "type": "string" },
    "customer_phone": { "type": "string" },
    "customer_id": { "type": "string" },
    "service_id": { "type": "string" },
    "service_name": { "type": "string" },
    "service_price": { "type": "number" },
    "service_duration": { "type": "number" },
    "barber_id": { "type": "string" },
    "barber_name": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "time": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "completed", "cancelled", "no_show"],
      "default": "pending"
    },
    "notes": { "type": "string" },
    "admin_notes": { "type": "string" },
    "reminder_sent_24h": { "type": "boolean", "default": false },
    "reminder_sent_2h": { "type": "boolean", "default": false }
  },
  "required": ["customer_name", "customer_phone", "service_name", "date", "time"]
}