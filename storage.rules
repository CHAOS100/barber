rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isActiveGalleryImage(imageId) {
      return firestore.exists(/databases/(default)/documents/gallery/$(imageId))
        && firestore.get(/databases/(default)/documents/gallery/$(imageId)).data.active == true;
    }

    function isValidGalleryImageUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /gallery/{imageId}/{fileName} {
      allow read: if isAdmin() || isActiveGalleryImage(imageId);
      allow create, update: if isAdmin() && isValidGalleryImageUpload();
      allow delete: if isAdmin();
    }

    match /barbers/{barberId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow delete: if isAdmin();
    }

    match /settings/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
